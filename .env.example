# --- Painel da TI (HTTP Basic) ---
PANEL_USER=admin
PANEL_PASS=troque-esta-senha
PANEL_URL=https://desk.suarede.com.br/painel

# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN=            # token permanente do usuário de sistema
WA_PHONE_ID=         # "Phone number ID" do número comercial
VERIFY_TOKEN=invente-um-texto-secreto   # o mesmo que você digitar na Meta ao configurar o webhook
APP_SECRET=          # "App secret" do app na Meta (valida a assinatura do webhook)
GRAPH_VERSION=v21.0  # confira a versão vigente na documentação da Meta

# --- E-mail para a TI ---
TI_EMAILS=ti@suarede.com.br,suporte@suarede.com.br
SMTP_HOST=smtp.suarede.com.br
SMTP_PORT=587
SMTP_USER=desk@suarede.com.br
SMTP_PASS=
SMTP_FROM=desk@suarede.com.br

# --- Dados ---
DB_PATH=desk.db
UPLOADS=uploads
